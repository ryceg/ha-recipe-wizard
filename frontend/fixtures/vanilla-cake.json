    },
    {
      "rows": [
        {
          "label": "caster sugar",
          "weight": "600 g",
          "scaling": "120.0%"
        }
      ],
      "steps": [
        {
          "step_id": "#add-sugar",
          "position": 5,
          "text": "With beater running, pour sugar in over 45 seconds."
        },
        {
          "step_id": "#beat-to-ribbon",
          "position": 6,
          "text": "Beat for 7 minutes on speed 8 until tripled in volume and white/pale."
        }
      ],
      "result": "Aerated egg foam"
    },
    {
      "rows": [
        {
          "label": "unsalted butter",
          "weight": "230 g",
          "scaling": "46.0%"
        },
        {
          "label": "full-fat milk",
          "weight": "495 g",
          "scaling": "99.1%"
        }
      ],
      "steps": [
        {
          "step_id": "#melt-butter-milk",
          "position": 7,
          "text": "While eggs are beating, place butter and milk in a heatproof jug. Microwave on high for 2 minutes to melt butter (or use stovetop)."
        },
        {
          "step_id": "#fold-flour",
          "position": 8,
          "text": "Add flour in 3 batches to egg mixture, beating for 5 seconds on speed 1 between each addition. After final addition, beat for 5-10 seconds until no flour is visible, then stop immediately."
        }
      ],
      "result": "Base batter"
    },
    {
      "rows": [
        {
          "label": "vanilla extract",
          "weight": "19 g",
          "scaling": "3.7%"
        },
        {
          "label": "vegetable oil",
          "weight": "28 g",
          "scaling": "5.5%"
        }
      ],
      "steps": [
        {
          "step_id": "#combine-liquids",
          "position": 9,
          "text": "Pour hot milk, vanilla extract, and oil into the now-empty flour bowl."
        },
        {
          "step_id": "#temper-batter",
          "position": 10,
          "text": "Add approximately 1 1/2 cups (2 ladles) of cake batter to the hot milk. Whisk vigorously until smooth and foamy."
        },
        {
          "step_id": "#add-hot-milk",
          "position": 11,
          "text": "Turn beater to speed 1. Slowly pour the hot milk mixture into the cake batter over 15 seconds, then turn beater off."
        },
        {
          "step_id": "#final-mix",
          "position": 12,
          "text": "Scrape down bowl sides and base. Beat on speed 1 for 10 seconds until batter is smooth and pourable."
        },
        {
          "step_id": "#pour-pans",
          "position": 13,
          "text": "Pour batter evenly into prepared pans (approximately 560g/20 oz per pan)."
        },
        {
          "step_id": "#bang-pans",
          "position": 14,
          "text": "Bang each pan on counter 3 times to knock out large air bubbles."
        },
        {
          "step_id": "#bake",
          "position": 15,
          "text": "Bake for 30 minutes until golden brown and a toothpick inserted into the centre comes out clean."
        },
        {
          "step_id": "#cool-in-pan",
          "position": 16,
          "text": "Remove from oven. Cool in pans for 15 minutes."
        },
        {
          "step_id": "#cool-out",
          "position": 17,
          "text": "Gently turn out onto cooling racks. For level layers, cool upside down; the slight dome flattens as the cake cools."
        }
      ],
      "result": "Cooled cake layers"
    },
    {
      "rows": [
        {
          "label": "Vanilla buttercream (sub-recipe)",
          "weight": "-",
          "scaling": "-",
          "component": true
        }
      ],
      "steps": [
        {
          "step_id": "#assemble",
          "position": 18,
          "text": "Once cake layers are fully cool, frost between the layers and on the top and sides with the vanilla buttercream."
        }
      ],
      "result": "Frosted vanilla cake"
    }
  ],
