  "name": "Peanut Butter Stuffed Brownies",
  "url": "https://www.recipetineats.com/peanut-butter-stuffed-brownies/",
  "author": {"@type": "Person", "name": "Nagi Maehashi"},
  "isBasedOn": "https://www.recipetineats.com/peanut-butter-stuffed-brownies/",

  "rw:measurementSystem": "AU",
  "rw:canonicalUnitSystem": "metric",
  "rw:enrichmentLevel": 3,

  "rw:note": "Encoded to exercise the three portion kinds and both delay directions. The peanut butter is split by remainder and by absolute measure; the brownie batter is split by fraction and by remainder; the cut cannot happen until three hours after the bake, and serving cannot happen until fifteen minutes after the cut.",

  "prepTime": "PT30M",
  "cookTime": "PT32M",
  "recipeYield": [{"@type": "QuantitativeValue", "value": 16, "unitText": "squares"}],
  "rw:yieldBasis": "sumOfInputs",
  "rw:massLossFactor": 0.04,
  "rw:scalingBasis": {"@id": "#chocolate"},

  "rw:vessel": {"rw:name": "20 cm (8\") square pan", "rw:count": 1},

  "rw:storage": [
    {
      "rw:method": "airtight-pantry",
      "rw:keeps": "P4D",
      "rw:condition": "unless it is very warm where you are"
    },
    {
      "rw:method": "refrigerated",
      "rw:keeps": "P7D",
      "rw:qualityNote": "eaten fridge-cold they are firmer and more fudge-like; 15 minutes at room temperature brings back the creamy peanut butter"
    }
  ],

  "tool": [
    {"@type": "HowToTool", "@id": "#square-pan", "name": "20 cm / 8\" square pan"},
    {"@type": "HowToTool", "@id": "#freezer", "name": "freezer with space for the pan"}
  ],

  "recipeIngredient": [
    "1 cup (250g) smooth peanut butter spread",
    "1 tsp salt flakes, divided",
    "200g / 14 tbsp unsalted butter",
    "1 1/4 cups (200g) dark chocolate chips",
    "1 cup loosely packed brown sugar",
    "3 large eggs, lightly beaten",
    "1 tsp vanilla extract",
    "1/2 cup plain flour",
    "1/4 cup cocoa powder",
    "1/8 tsp cooking salt"
  ],

  "rw:ingredients": [
    {
      "@id": "#peanut-butter",
      "@type": "rw:Ingredient",
      "rw:food": {"@id": "food:peanut-butter-smooth", "name": "smooth peanut butter"},
      "rw:mass": {"value": 250, "unitCode": "GRM", "rw:display": "1 cup / 250 g"},
      "rw:scaling": "linear",
      "rw:originalText": "1 cup (250g) smooth peanut butter spread for stuffing",
      "rw:note": "Split two ways: 2 tbsp is reserved for the surface swirl and everything else is frozen into the slab. Before rw:portion existed the whole 250 g rendered against the first step and the swirl step showed no ingredient at all."
    },
    {
