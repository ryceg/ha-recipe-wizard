      "@type": "rw:Ingredient",
      "rw:food": {"@id": "food:salt-flakes", "name": "salt flakes"},
      "rw:volume": {"value": 1, "unitText": "tsp", "rw:display": "1 tsp, divided"},
      "rw:scaling": "sublinear",
      "rw:originalText": "1 tsp salt flakes, divided",
      "rw:note": "The source says 'divided' and then only ever accounts for half of it. Recorded as stated rather than guessed at, which the portion validator reports."
    },
    {
      "@id": "#butter",
      "@type": "rw:Ingredient",
      "rw:food": {"@id": "food:butter-unsalted", "name": "unsalted butter"},
