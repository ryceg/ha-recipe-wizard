  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "@id": "#saute-aromatics",
      "position": 1,
      "text": "Heat oil in a skillet over high heat. Add ginger and garlic and saute for 30 seconds until golden, don't let it burn. Add onion and cook for 1 minute until it is starting to turn translucent.",
      "rw:consumes": [
        {"@id": "#oil"}, {"@id": "#ginger"}, {"@id": "#garlic"}, {"@id": "#onion"}
      ],
      "rw:produces": [{"@id": "#aromatics", "name": "Fried aromatics"}],
      "rw:attention": "active",
      "totalTime": "PT90S",
      "rw:doneness": "garlic golden but not burnt, onion starting to turn translucent",
      "tool": [{"@id": "#skillet"}]
    },
    {
      "@type": "HowToStep",
      "@id": "#brown-and-bloom",
      "position": 2,
      "text": "Add beef and cook, breaking it up as you go, until it changes from pink to light brown. Add the salt and all the spices. Cook for a further 2 minutes to let the spices bloom.",
      "rw:consumes": [
        {"@id": "#aromatics"}, {"@id": "#beef"}, {"@id": "#salt"},
        {"@id": "#cayenne"}, {"@id": "#garam-masala"}, {"@id": "#cumin"},
        {"@id": "#coriander-powder"}, {"@id": "#turmeric"}
      ],
      "rw:produces": [{"@id": "#bloomed", "name": "Browned, spiced beef"}],
      "rw:attention": "active",
      "totalTime": "PT5M",
      "rw:doneness": "no pink left in the beef, and the spices smell toasted",
      "rw:maxDelayAfter": [
        {"rw:from": {"@id": "#saute-aromatics"}, "rw:limit": "PT0S",
         "rw:reason": "the aromatics are in a hot dry pan and will scorch if left"}
      ]
    },
    {
      "@type": "HowToStep",
      "@id": "#simmer",
      "position": 3,
      "text": "Add water, give it a stir, then put a lid on. Turn heat down to medium and let it simmer for 10 minutes or until most of the water has evaporated.",
      "rw:consumes": [{"@id": "#bloomed"}, {"@id": "#water"}],
      "rw:produces": [{"@id": "#qeema", "name": "Qeema"}],
      "rw:attention": "unattended",
      "totalTime": "PT10M",
      "rw:doneness": "most of the water has evaporated but the mince is still a bit juicy",
      "rw:donenessNote": "The source gives the time and the state together, and the state is the one that decides. Ten minutes is an estimate.",
      "tool": [{"@id": "#skillet"}]
    },
    {
      "@type": "HowToStep",
      "@id": "#serve",
      "position": 4,
      "text": "Serve garnished with extra chilli and coriander, and lots of mint yogurt.",
      "rw:consumes": [
        {"@id": "#qeema"}, {"@id": "#green-chilli"},
        {"@id": "#coriander-leaves"}, {"@id": "#mint-yogurt"}
      ],
      "rw:produces": [{"@id": "#plated", "name": "Qeema, plated"}],
      "rw:attention": "active"
    }
  ],

  "rw:notes": [
    "Fresh spices matter more than anything else here.",
    "Chicken mince works in place of beef.",
    "Omit the cayenne entirely for a not-spicy version."
  ]
